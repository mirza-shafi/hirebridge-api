# --- App ---
ENVIRONMENT=local                 # local | staging | production
LOG_LEVEL=INFO
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://hirebridge:hirebridge@localhost:5432/hirebridge

# --- Redis (queue, cache, pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Skip Clerk entirely for local work. Refused unless ENVIRONMENT=local.
DEV_AUTH=false
DEV_AUTH_TOKEN=dev-token

# --- Auth (Clerk) ---
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=

# --- LLM providers (Phase 1 — leave blank until chosen) ---
LLM_PROVIDER=fake                 # fake | anthropic | openai | ollama
#   fake      -> deterministic fixtures, no network. Default for local and CI.
#   anthropic -> structured output via a forced tool call
#   openai    -> structured output via strict json_schema
# Set the three model names below to the tier you want; pricing goes in
# config/model_pricing.json so the cost dashboard is accurate.
LLM_API_KEY=
MODEL_SMALL=
MODEL_MID=
MODEL_LARGE=
# Anthropic has NO embeddings API. Set these even when LLM_PROVIDER=anthropic.
OLLAMA_BASE_URL=http://localhost:11434   # used when either provider is 'ollama'

EMBEDDING_PROVIDER=fake           # fake | openai | voyage | ollama
EMBEDDING_API_KEY=
EMBEDDING_MODEL=fake-embedding    # text-embedding-3-small (1536) | nomic-embed-text (768)
# MUST match the model above — the vector columns are sized from this at migration time.
EMBEDDING_DIM=1536

# --- Object storage (Phase 1) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Budgets ---
DEFAULT_ORG_MONTHLY_TOKEN_BUDGET=5000000
