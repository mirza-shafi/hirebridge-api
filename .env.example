# --- App ---
ENVIRONMENT=local                 # local | staging | production
LOG_LEVEL=INFO
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://hirebridge:hirebridge@localhost:5432/hirebridge

# --- Redis (queue, cache, pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Clerk) ---
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=

# --- LLM providers (Phase 1 — leave blank until chosen) ---
LLM_PROVIDER=fake                 # fake | anthropic | openai
LLM_API_KEY=
MODEL_SMALL=
MODEL_MID=
MODEL_LARGE=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# --- Object storage (Phase 1) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Budgets ---
DEFAULT_ORG_MONTHLY_TOKEN_BUDGET=5000000
